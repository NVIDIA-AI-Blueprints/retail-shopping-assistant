# Retail Shopping Assistant -- the app LLM, media and text embedding served
# locally by vLLM from Hugging Face checkpoints.
#
# .env.example with three roles moved, the ones the hosted default serves:
# Nemotron 3.5 Super answers the shopper and reads photo and video uploads, and
# Nemotron 3 Embed 1B embeds the catalog. Image embedding and guardrails stay
# on their hosted endpoints.
#
# Copy it, fill in the keys, and source it from the repo root:
#
#   cp .env.local-models.example .env.local-models
#   $EDITOR .env.local-models      # HF_TOKEN, NVIDIA_API_KEY
#   source .env.local-models
#
#   mkdir -p "$HF_CACHE"
#   docker compose -f docker-compose-nim-local.yaml up -d --wait nemotron embedqa
#   docker compose up -d --build
#
# The first start downloads the chat model's ~240 GB BF16 checkpoint into
# HF_CACHE and can take an hour; later starts load from the cache in minutes.
# Start the app after both are healthy: the catalog indexer embeds the catalog
# once, at startup.
#
# GPUs, for an 8x H100 80 GB machine by default:
#   nemotron  LOCAL_LLM_GPUS=0,1,2,3, LOCAL_LLM_TP=4 (the count must match)
#   embedqa   LOCAL_EMBED_GPU=4
#
# This file contains no secrets and is committed. The copy you fill in is
# ignored by .gitignore, like every other .env.*.

# Set before .env.example is sourced, which derives the hosted keys from it.
export NVIDIA_API_KEY="${NVIDIA_API_KEY:-}"

. ./.env.example

# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------
# The chat checkpoint is gated: the token needs access to it.
export HF_TOKEN="${HF_TOKEN:?set HF_TOKEN to a Hugging Face token with access to the Nemotron 3.5 Super checkpoint}"
export HF_CACHE="${HF_CACHE:-$HOME/.cache/huggingface}"

# ---------------------------------------------------------------------------
# Roles moved to the local services
# ---------------------------------------------------------------------------
# The environment is read before shared/configs/models.yaml is consulted, so
# this needs no change to tracked configuration. The service names resolve on
# the shopping network; from the host they are localhost:8000 and :8001.
#
# vLLM runs without authentication, and the OpenAI client sends a key
# regardless -- so the keys are set to a value rather than left empty.
export LLM_BASE_URL="http://nemotron:8000/v1"
export LLM_MODEL="nemotron-3.5-super"
export LLM_API_KEY="local"

# Media perception uses the same model, as it does hosted.
export VLM_BASE_URL="$LLM_BASE_URL"
export VLM_MODEL="$LLM_MODEL"
export VLM_API_KEY="local"

export TEXT_EMBED_BASE_URL="http://embedqa:8000/v1"
export TEXT_EMBED_MODEL="nvidia/Nemotron-3-Embed-1B-BF16"
