# Retail Shopping Assistant -- every model role served locally by vLLM from
# Hugging Face checkpoints.
#
# .env.example with every model role moved to this machine: Nemotron 3.5 Super
# answers the shopper and reads photo and video uploads, Nemotron 3 Embed 1B
# embeds the catalog, and the guardrail judges -- Nemotron 3.5 Content Safety,
# Llama 3.1 NemoGuard 8B Topic Control and Nemotron 3 Nano Omni for video --
# check each turn. Text embedding and guardrails can stay hosted; see their
# sections below.
#
# Copy it, fill in the keys, and source it from the repo root:
#
#   cp .env.local-models.example .env.local-models
#   ${EDITOR:-nano} .env.local-models   # HF_TOKEN
#   source .env.local-models
#
#   mkdir -p "$HF_CACHE"
#   docker compose -f docker-compose-model-local.yaml up -d --wait \
#     local-llm local-embedding local-content-safety local-topic-control local-video-safety
#   docker compose up -d --build
#
# The first start downloads ~300 GB into HF_CACHE, most of it the chat model's
# BF16 checkpoint, and can take an hour; later starts load from the cache in
# minutes. Start the app after every model is healthy: the catalog indexer
# embeds the catalog once, at startup.
#
# GPUs, six 80 GB GPUs by default; docs/DEPLOYMENT.md, GPU Sizing, has the
# other layouts:
#   local-llm             LOCAL_LLM_GPUS=0,1,2,3, LOCAL_LLM_TP=4 (the count must match)
#   local-embedding       LOCAL_EMBED_GPU=4            (shared)
#   local-content-safety  LOCAL_CONTENT_SAFETY_GPU=4   (shared)
#   local-topic-control   LOCAL_TOPIC_CONTROL_GPU=4    (shared)
#   local-video-safety    LOCAL_VIDEO_SAFETY_GPU=5
#
# This file contains no secrets and is committed. The copy you fill in is
# ignored by .gitignore, like every other .env.*.

# Set before .env.example is sourced, which derives the hosted keys from it.
# With every role local, no model call uses it; it is needed only for a role
# moved back to a hosted endpoint.
export NVIDIA_API_KEY="${NVIDIA_API_KEY:-}"

. ./.env.example

# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------
# Two checkpoints are gated, and the token needs access to both: the
# Nemotron 3.5 Super chat model, and meta-llama/Llama-3.1-8B-Instruct, the base
# of the topic-control adapter, which Meta approves by hand.
export HF_TOKEN="${HF_TOKEN:?set HF_TOKEN to a Hugging Face token with access to the Nemotron 3.5 Super and Llama 3.1 8B Instruct checkpoints}"
export HF_CACHE="${HF_CACHE:-$HOME/.cache/huggingface}"

# ---------------------------------------------------------------------------
# Roles moved to the local services
# ---------------------------------------------------------------------------
# These replace the hosted values .env.example set above, so this needs no
# change to tracked configuration. The service names resolve on
# the shopping network; from the host they are localhost:8000 and :8001.
#
# vLLM runs without authentication, and the OpenAI client sends a key
# regardless -- so the keys are set to a value rather than left empty.
export LLM_BASE_URL="http://local-llm:8000/v1"
export LLM_MODEL="nemotron-3.5-super"
export LLM_API_KEY="local"

# Media perception uses the same model, as it does hosted.
export VLM_BASE_URL="$LLM_BASE_URL"
export VLM_MODEL="$LLM_MODEL"
export VLM_API_KEY="local"

# Text embedding. To keep it on the hosted endpoint instead -- one GPU fewer,
# or a performance run where only the model serving the shopper changes --
# comment out these three lines and leave out local-embedding:
#
#   docker compose -f docker-compose-model-local.yaml up -d --wait \
#     local-llm local-content-safety local-topic-control local-video-safety
#
# .env.example's hosted TEXT_EMBED_* and EMBED_API_KEY then apply. Changing the
# embedding model rebuilds the catalog index when the app next starts.
export TEXT_EMBED_BASE_URL="http://local-embedding:8000/v1"
export TEXT_EMBED_MODEL="nvidia/Nemotron-3-Embed-1B-BF16"
export EMBED_API_KEY="local"

# Guardrails. Off by default, as on the hosted path: the shopper turns them on
# with the UI's Guardrails toggle, or set GUARDRAILS_ENABLED=true to make on the
# deployment default. Either way they then run on this machine. To keep them on their hosted
# endpoints instead, comment out this block, don't start the three guardrail
# services, and set RAIL_API_KEY and MULTIMODAL_SAFETY_API_KEY to
# build.nvidia.com keys.
#
# The model names are load-bearing: the guardrail service uses its dedicated
# on-topic/off-topic check only for a name containing "topic-control", and the
# Omni video request only for one containing "nemotron-3-nano-omni".
export RAILS_CONTENT_BASE_URL="http://local-content-safety:8000/v1"
export RAILS_CONTENT_MODEL="nvidia/nemotron-3.5-content-safety"
export RAILS_TOPIC_BASE_URL="http://local-topic-control:8000/v1"
export RAILS_TOPIC_MODEL="llama-3.1-nemoguard-8b-topic-control"
export RAIL_API_KEY="local"

# Video safety, including embedded audio. Video is added to the checked
# modalities so the local Omni judge is used.
export MULTIMODAL_SAFETY_BASE_URL="http://local-video-safety:8000/v1"
export MULTIMODAL_SAFETY_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
export MULTIMODAL_SAFETY_API_KEY="local"

export GUARDRAILS_SUPPORTED_MODALITIES="text,image,video"

# ---------------------------------------------------------------------------
# What the local server lets you see
# ---------------------------------------------------------------------------
# vLLM arguments are the service's `command` in docker-compose-model-local.yaml,
# which is where --max-num-seqs and the tool-call parser are set. Raise
# --max-num-seqs there to admit more concurrent sequences when driving load.
#
# local-llm serves vLLM's Prometheus metrics on its own port, with nothing to
# enable:
#
#   curl -s http://localhost:8000/metrics | grep -E '^vllm:'
#
# These are the numbers a hosted endpoint cannot give you -- tokens in and out,
# time to first token, queue depth, KV-cache utilisation, running and waiting
# sequences. Under load `vllm:num_requests_waiting` answers whether the model is
# the bottleneck. monitoring/ scrapes them into Prometheus and Grafana
# (monitoring/README.md).
