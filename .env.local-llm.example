# Retail Shopping Assistant -- the app LLM served locally by vLLM.
#
# .env.example with one role moved. Everything else stays on the hosted
# endpoints: embeddings, the VLM, guardrails, the judge and the challenger. Only
# the model serving the shopper changes, so a run against this profile and a
# run against .env.example differ by that and nothing else, which is what makes
# the two comparable.
#
# Copy it, fill in the keys, and source it from the repo root:
#
#   cp .env.local-llm.example .env.local-llm
#   $EDITOR .env.local-llm        # NVIDIA_API_KEY, HF_TOKEN
#   source .env.local-llm
#
#   mkdir -p "$HF_CACHE"
#   docker compose -f docker-compose-local-models.yaml up -d --wait local-llm
#   docker compose up -d
#
# The first start downloads the ~240 GB BF16 checkpoint into HF_CACHE and takes
# a long while. The model needs four 80 GB GPUs; docker-compose-local-models.yaml
# reserves LOCAL_LLM_GPUS, default 0,1,2,3. .env.local-models.example moves
# media and text embedding as well.
#
# This file contains no secrets and is committed. The copy you fill in is
# ignored by .gitignore, like every other .env.*.

# Set before .env.example is sourced, which derives the other hosted keys from it.
export NVIDIA_API_KEY="${NVIDIA_API_KEY:-}"

. ./.env.example

# ---------------------------------------------------------------------------
# App LLM -- local vLLM instead of a hosted endpoint
# ---------------------------------------------------------------------------
# These override the values from .env.example. The environment is read before
# shared/configs/models.yaml is consulted, so running locally needs no change
# to tracked configuration.
#
# `local-llm` is the compose service name and resolves on the shopping network.
# From the host the same server is at localhost:8000.
export LLM_BASE_URL="http://local-llm:8000/v1"
export LLM_MODEL="nemotron-3.5-super"

# vLLM on the compose network needs no authentication, and the OpenAI client
# sends a key regardless -- so this is set to a value rather than left empty.
export LLM_API_KEY="local"

# The checkpoint is gated: the token needs access to it on Hugging Face.
export HF_TOKEN="${HF_TOKEN:?set HF_TOKEN to a Hugging Face token with access to the Nemotron 3.5 Super checkpoint}"
export HF_CACHE="${HF_CACHE:-$HOME/.cache/huggingface}"

# vLLM arguments are the service's `command` in docker-compose-local-models.yaml,
# which is where --max-num-seqs and the tool-call parser are set. Raise
# --max-num-seqs there to admit more concurrent sequences when driving load.

# ---------------------------------------------------------------------------
# What the local server lets you see
# ---------------------------------------------------------------------------
# It serves vLLM's Prometheus metrics on its own port, with nothing to enable:
#
#   curl -s http://localhost:8000/metrics | grep -E '^vllm:'
#
# These are the numbers a hosted endpoint cannot give you -- tokens in and out,
# time to first token, queue depth, KV-cache utilisation, running and waiting
# sequences. Under load `vllm:num_requests_waiting` answers whether the model is
# the bottleneck.
#
# monitoring/ scrapes them into Prometheus and Grafana (monitoring/README.md).
# It targets the NIM at nemotron:8000; point monitoring/prometheus.yaml at
# local-llm:8000 for this server.
